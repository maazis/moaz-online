---
import Layout from "../layouts/Layout.astro";
import Loader from "../components/Loader.astro";
import Name from "../components/Name.astro";
import AboutDialog from "../components/AboutDialog.astro";
import {
  content,
  FOOTER_TEXT_1,
  FOOTER_TEXT_2,
  FOOTER_TEXT_3,
} from "../utils/constants";

const { title, bio, degree, degreeDetail } = content.currentWorks;
const LOADER_IMAGE = "/drifter.gif";
---

<Layout>
  <link slot="head" rel="preload" as="image" href={LOADER_IMAGE} />

  <script is:inline>
    // Runs before first paint so the loader covers the page from the start.
    document.documentElement.classList.add("has-js", "is-loading");
  </script>

  <Loader src={LOADER_IMAGE} />

  <main
    class="landing-page landing-grid text-primary can-bg-change"
    data-landing-page
  >
    <Name
      class="[grid-area:name]"
      name1={content.name1}
      name2={content.name2}
      subtitle={content.subtitle}
      stretchIndices={content.nameStretchIndices}
    />

    <div
      class="[grid-area:bio] flex items-center justify-start md:justify-center px-1 md:px-6"
    >
      <div>
        {
          title && (
            <p class="font-national-park font-semibold text-center mb-1">
              {title}
            </p>
          )
        }
        <div class="font-national-park space-y-0.5 text-center text-sm">
          <p>
            {bio.prefix}
            <a
              href={bio.url}
              target="_blank"
              rel="noopener noreferrer"
              class="link"
            >
              {bio.text}
            </a>
          </p>
          <p class="mt-2">{degree}</p>
          <p class="italic">{degreeDetail}</p>
        </div>
      </div>
    </div>

    <div
      class="[grid-area:published] flex flex-col items-start justify-center px-12"
    >
      <p class="font-national-park font-semibold mb-1">
        {content.published.title}
      </p>
      <ul class="text-left text-sm space-y-2 md:space-y-0">
        {
          content.published.links.map((link) => (
            <li>
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="link"
              >
                {link.text}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="[grid-area:roles] flex flex-row md:flex-col items-start justify-center gap-6 px-6 md:px-0"
    >
      {
        content.roles.map((role) => (
          <div>
            <p class="font-national-park font-semibold mb-1">{role.title}</p>
            <ul class="text-left list-disc text-sm space-y-2 md:space-y-0">
              {role.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="[grid-area:contact] flex flex-col items-center md:items-end justify-center md:justify-end gap-1 md:gap-0 md:pr-6"
    >
      {
        content.contactItems.map((item) => (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="link"
          >
            <span class="font-national-park flex items-center gap-1">
              <i class={item.iconClass} aria-hidden="true" />
              {item.text}
            </span>
          </a>
        ))
      }
    </div>

    <div
      class="[grid-area:footer] self-end md:self-stretch flex flex-col items-center md:items-start md:justify-end px-6 md:pl-6 md:pr-0 font-coral-pixels text-sm"
    >
      <button
        type="button"
        class="cursor-pointer hover:text-current/70 transition-all duration-50"
        data-about-open>{FOOTER_TEXT_2}</button
      >
      {FOOTER_TEXT_1}
      <p class="font-barcode">{FOOTER_TEXT_3}</p>
    </div>
  </main>

  <AboutDialog />

  <style>
    .landing-grid {
      display: grid;
      min-height: 100dvh;
      row-gap: 2.5rem;
      column-gap: 0;
      padding: 1.5rem 1rem;
      grid-template-columns: auto 1fr;
      grid-template-rows: auto auto auto auto 1fr;
      grid-template-areas:
        "name      bio"
        "published published"
        "roles     roles"
        "contact   contact"
        "footer    footer";
    }

    @media (min-width: 48rem) {
      .landing-grid {
        height: 100dvh;
        row-gap: 0;
        padding: 1rem;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: repeat(3, minmax(0, 1fr));
        grid-template-areas:
          ".      bio       ."
          "name   .         roles"
          "footer published contact";
      }
    }

    /*
     * Wide but very short viewports (landscape phones): keep the desktop
     * arrangement but let the page grow and scroll instead of clipping.
     */
    @media (min-width: 48rem) and (height < 30rem) {
      .landing-grid {
        height: auto;
        grid-template-rows: repeat(3, auto);
      }
    }
  </style>

  <script>
    import { animate } from "animejs";

    /** How long the loader stays up once the page is ready. */
    const LOADER_HOLD_MS = 1600;
    /** Never let a slow font or image download hold the page longer than this. */
    const LOADER_ASSET_TIMEOUT_MS = 2000;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const delay = (ms: number) =>
      new Promise<void>((resolve) => window.setTimeout(resolve, ms));

    const loaderImageReady = () => {
      const image = document.querySelector("[data-site-loader-image]");

      if (!(image instanceof HTMLImageElement) || image.complete) {
        return Promise.resolve();
      }

      return new Promise<void>((resolve) => {
        image.addEventListener("load", () => resolve(), { once: true });
        image.addEventListener("error", () => resolve(), { once: true });
      });
    };

    const fontsReady = () =>
      "fonts" in document ? document.fonts.ready.then(() => {}) : Promise.resolve();

    const assetsReady = () =>
      Promise.race([
        Promise.all([fontsReady(), loaderImageReady()]),
        delay(LOADER_ASSET_TIMEOUT_MS),
      ]);

    if (!prefersReducedMotion) {
      const revealPage = () => {
        const loader = document.querySelector("[data-site-loader]");
        const landingPage = document.querySelector("[data-landing-page]");

        document.documentElement.classList.remove("is-loading");

        if (landingPage instanceof HTMLElement) {
          landingPage.classList.add("is-visible");
        }

        if (loader instanceof HTMLElement) {
          animate(loader, {
            opacity: [1, 0],
            duration: 220,
            ease: "outQuad",
            onComplete: () => {
              loader.remove();
            },
          });
        }
      };

      Promise.all([delay(LOADER_HOLD_MS), assetsReady()]).then(revealPage);
    } else {
      document.documentElement.classList.remove("is-loading");
      document.querySelector("[data-site-loader]")?.remove();
      document
        .querySelector("[data-landing-page]")
        ?.classList.add("is-visible");
    }
  </script>
</Layout>
