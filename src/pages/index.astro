---
import Layout from "../layouts/Layout.astro";
import Loader from "../components/Loader.astro";
import Name from "../components/Name.astro";
import {
  content,
  FOOTER_TEXT_1,
  FOOTER_TEXT_2,
  FOOTER_TEXT_3,
} from "../utils/constants";

const { title, bio, degree, degreeDetail } = content.currentWorks;
const loaderText = "connecting to https://www.moaz.net";
---

<Layout>
  <script is:inline>
    document.documentElement.classList.add("is-loading");
  </script>

  <Loader text={loaderText} />

  <main
    class="landing-page landing-grid text-primary can-bg-change"
    data-landing-page
  >
    <Name
      class="[grid-area:name]"
      name1={content.name1}
      name2={content.name2}
      subtitle={content.subtitle}
      stretchIndices={content.nameStretchIndices}
    />

    <div
      class="[grid-area:bio] flex items-center justify-start md:justify-center px-1 md:px-6"
    >
      <div>
        {
          title && (
            <p class="font-national-park font-semibold text-center mb-1">
              {title}
            </p>
          )
        }
        <div class="font-national-park space-y-0.5 text-center text-sm">
          <p>
            {bio.prefix}
            <a
              href={bio.url}
              target="_blank"
              rel="noopener noreferrer"
              class="link"
            >
              {bio.text}
            </a>
          </p>
          <p class="mt-2">{degree}</p>
          <p class="italic">{degreeDetail}</p>
        </div>
      </div>
    </div>

    <div
      class="[grid-area:published] flex flex-col items-start justify-center px-12"
    >
      <p class="font-national-park font-semibold mb-1">
        {content.published.title}
      </p>
      <ul class="text-left text-sm space-y-2 md:space-y-0">
        {
          content.published.links.map((link) => (
            <li>
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="link"
              >
                {link.text}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="[grid-area:roles] flex flex-row md:flex-col items-start justify-center gap-6 px-6 md:px-0"
    >
      {
        content.roles.map((role) => (
          <div>
            <p class="font-national-park font-semibold mb-1">{role.title}</p>
            <ul class="text-left list-disc text-sm space-y-2 md:space-y-0">
              {role.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="[grid-area:contact] flex flex-col items-center md:items-end justify-center md:justify-end gap-1 md:gap-0 md:pr-6"
    >
      {
        content.contactItems.map((item) => (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="link"
          >
            <span class="font-national-park flex items-center gap-1">
              <i class={item.iconClass} aria-hidden="true" />
              {item.text}
            </span>
          </a>
        ))
      }
    </div>

    <div
      class="[grid-area:footer] self-end md:self-stretch flex flex-col items-center md:items-start md:justify-end px-6 md:pl-6 md:pr-0 font-coral-pixels text-sm"
    >
      <a
        class="hover:text-current/70 transition-all duration-50"
        href="/about-this-website">{FOOTER_TEXT_2}</a
      >
      {FOOTER_TEXT_1}
      <p class="font-barcode">{FOOTER_TEXT_3}</p>
    </div>
  </main>

  <style>
    .landing-grid {
      display: grid;
      min-height: 100dvh;
      row-gap: 2.5rem;
      column-gap: 0;
      padding: 1.5rem 1rem;
      grid-template-columns: auto 1fr;
      grid-template-rows: auto auto auto auto 1fr;
      grid-template-areas:
        "name      bio"
        "published published"
        "roles     roles"
        "contact   contact"
        "footer    footer";
    }

    @media (min-width: 48rem) {
      .landing-grid {
        height: 100dvh;
        row-gap: 0;
        padding: 1rem;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: repeat(3, minmax(0, 1fr));
        grid-template-areas:
          ".      bio       ."
          "name   .         roles"
          "footer published contact";
      }
    }

    /*
     * Wide but very short viewports (landscape phones): keep the desktop
     * arrangement but let the page grow and scroll instead of clipping.
     */
    @media (min-width: 48rem) and (height < 30rem) {
      .landing-grid {
        height: auto;
        grid-template-rows: repeat(3, auto);
      }
    }
  </style>

  <script>
    import { animate } from "animejs";

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const typeChars = (
      characters: HTMLElement[],
      { duration, step }: { duration: number; step: number },
    ) => {
      const widths = characters.map((character) => `${character.scrollWidth}px`);

      characters.forEach((character, index) => {
        animate(character, {
          opacity: [0, 1],
          maxWidth: ["0px", widths[index] ?? "0px"],
          duration,
          delay: index * step,
          ease: "steps(1)",
        });
      });
    };

    if (!prefersReducedMotion) {
      const typeName = () => {
        const nameElement = document.querySelector(".animated-name");

        if (
          !(nameElement instanceof HTMLElement) ||
          nameElement.dataset.typed === "true"
        ) {
          return;
        }

        nameElement.dataset.typed = "true";
        typeChars(
          Array.from(nameElement.querySelectorAll<HTMLElement>(".typed-char")),
          { duration: 45, step: 75 },
        );
      };

      const revealPage = () => {
        const loader = document.querySelector("[data-site-loader]");
        const landingPage = document.querySelector("[data-landing-page]");

        document.documentElement.classList.remove("is-loading");

        if (landingPage instanceof HTMLElement) {
          landingPage.classList.add("is-visible");
        }

        if (loader instanceof HTMLElement) {
          animate(loader, {
            opacity: [1, 0],
            duration: 220,
            delay: 120,
            ease: "outQuad",
            onComplete: () => {
              loader.remove();
            },
          });
        }

        typeName();
      };

      const runLoader = () => {
        const loaderProgress = document.querySelector(
          "[data-site-loader-progress]",
        );

        typeChars(
          Array.from(
            document.querySelectorAll<HTMLElement>(
              "[data-site-loader] .typed-char",
            ),
          ),
          { duration: 22, step: 20 },
        );

        if (loaderProgress) {
          animate(loaderProgress, {
            scaleX: [0, 1],
            duration: 760,
            ease: "inOutQuad",
          });
        }

        window.setTimeout(revealPage, 950);
      };

      if ("fonts" in document) {
        document.fonts.ready.then(runLoader);
      } else {
        runLoader();
      }
    } else {
      document.documentElement.classList.remove("is-loading");
      document.querySelector("[data-site-loader]")?.remove();
      document
        .querySelector("[data-landing-page]")
        ?.classList.add("is-visible");
    }
  </script>
</Layout>
