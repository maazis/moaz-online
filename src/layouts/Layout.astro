---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>moaz.net</title>
    <meta name="description" content="writer and backend engineer." />

    <!-- Open Graph tags -->
    <meta property="og:title" content="moaz.net" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://moaz.net/" />
    <meta property="og:description" content="Maaz is online." />
    <meta
      property="og:image"
      content="https://moaz.net/street-guangyuan.jpg"
    />
    <meta
      property="og:image:alt"
      content="artwork of a street from GuangYuan YU"
    />

    <!-- GoatCounter Analytics -->
    <script
      data-goatcounter="https://moazzstaysonline.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"></script>
  </head>

  <body class="h-screen bg-background overflow-x-hidden md:overflow-hidden">
    <slot />
  </body>
</html>
