---
import TypedChars from "./TypedChars.astro";

interface Props {
  name1: string;
  name2: string;
  subtitle: string;
  stretchIndices?: number[];
  class?: string;
}

const {
  name1,
  name2,
  subtitle,
  stretchIndices = [],
  class: className,
} = Astro.props;
---

<div
  class:list={[
    "flex flex-col items-start md:items-end md:justify-center px-6 md:px-0",
    className,
  ]}
>
  <h1
    class="animated-name font-special-gothic-expanded text-5xl mb-2 text-left name-hover-trigger"
    aria-label={`${name1} ${name2}`}
  >
    <span aria-hidden="true">
      <span class="animated-name-line">
        <TypedChars text={name1} />
      </span>
      <span class="animated-name-line">
        <TypedChars text={name2} stretchIndices={stretchIndices} />
        <span class="animated-name-cursor"></span>
      </span>
    </span>
  </h1>
  <p class="font-national-park text-xs">{subtitle}</p>
</div>
